<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- 共享的无界面代码：Agent 服务层、画布逻辑、智能导入、站点池子…（第 127 轮之前它是用
         <Compile Include> 从旧 WinForms 端「借」的，现在是一个正常的库，来源只有一处）。 -->
    <ProjectReference Include="..\YEEYEEYEE.Desktop.Shared\YEEYEEYEE.Desktop.Shared.csproj" />
    <!-- 封面提取与本地播放住在桌面端（Avalonia + WebView2）里，它们的边界（路径校验、
         令牌会话的字节服务与文件句柄释放）要被离线回归盯住，所以这里也引用桌面工程。
         internal 通过 Desktop.Avalonia 的 InternalsVisibleTo 打开。 -->
    <ProjectReference Include="..\YEEYEEYEE.Desktop.Avalonia\YEEYEEYEE.Desktop.Avalonia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 真机取样：ComfyUI 的「网页格式」工作流 + 用户从网页导出的「API 格式」工作流 + 节点定义子集。
         转换器就靠这几份逐字对拍验收（见 fixtures/comfyui/README 节说明）。 -->
    <Content Include="fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
