{
  "protocolVersion": 1,
  "note": "C# 端与 TypeScript 端共用的一致性夹具。任何新增消息类型必须先加夹具再改两端实现，禁止只改一端。",
  "fixtures": [
    { "file": "canvas-hello.v1.json", "direction": "canvasToHost", "type": "canvas/hello", "valid": true },
    { "file": "canvas-op-batch.v1.json", "direction": "canvasToHost", "type": "canvas/op.batch", "valid": true },
    { "file": "canvas-undo-request.v1.json", "direction": "canvasToHost", "type": "canvas/undo.request", "valid": true },
    { "file": "canvas-invoke-request.v1.json", "direction": "canvasToHost", "type": "canvas/invoke.request", "valid": true },
    { "file": "host-init.v1.json", "direction": "hostToCanvas", "type": "host/init", "valid": true },
    { "file": "host-op-batch.v1.json", "direction": "hostToCanvas", "type": "host/op.batch", "valid": true },
    { "file": "host-job-update.v1.json", "direction": "hostToCanvas", "type": "host/job.update", "valid": true },
    { "file": "host-capabilities.v1.json", "direction": "hostToCanvas", "type": "host/capabilities", "valid": true },
    { "file": "host-error-fatal.v1.json", "direction": "hostToCanvas", "type": "host/error", "valid": true },
    { "file": "invalid/unknown-type.v1.json", "direction": "canvasToHost", "type": "canvas/teleport", "valid": false, "expectedErrorCode": "PROTOCOL_UNKNOWN_TYPE" },
    { "file": "invalid/version-mismatch.v1.json", "direction": "canvasToHost", "type": "canvas/hello", "valid": false, "expectedErrorCode": "PROTOCOL_VERSION_MISMATCH" },
    { "file": "invalid/wrong-direction.v1.json", "direction": "canvasToHost", "type": "host/init", "valid": false, "expectedErrorCode": "PROTOCOL_DIRECTION_MISMATCH" },
    { "file": "invalid/malformed-missing-id.v1.json", "direction": "canvasToHost", "type": "canvas/op.batch", "valid": false, "expectedErrorCode": "PROTOCOL_MALFORMED" },
    { "file": "invalid/malformed-null-payload.v1.json", "direction": "canvasToHost", "type": "canvas/op.batch", "valid": false, "expectedErrorCode": "PROTOCOL_MALFORMED" },
    { "file": "invalid/undo-not-local.v1.json", "direction": "canvasToHost", "type": "canvas/undo.request", "valid": false, "expectedErrorCode": "PROTOCOL_UNAUTHORIZED" },
    { "file": "invalid/invoke-missing-idempotency.v1.json", "direction": "canvasToHost", "type": "canvas/invoke.request", "valid": false, "expectedErrorCode": "PROTOCOL_MALFORMED" },
    { "file": "invalid/host-init-bad-version.v1.json", "direction": "hostToCanvas", "type": "host/init", "valid": false, "expectedErrorCode": "PROTOCOL_VERSION_MISMATCH" },
    { "file": "invalid/host-init-client-supplied-role.v1.json", "direction": "hostToCanvas", "type": "host/init", "valid": false, "expectedErrorCode": "PROTOCOL_UNAUTHORIZED" }
  ]
}
