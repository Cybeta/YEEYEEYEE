<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 单目标框架 net10.0：Windows / macOS / Linux 出同一份代码。
         平台差异（密钥落盘方案、窗口外观）由**运行时**判断，不用条件编译，避免同一份源码在不同 TFM 下行为分叉。 -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- 版本号的唯一来源：界面标题栏、左栏底部与设置页都读这里（见 AppVersion）。
         改这一行就是改版本号，不需要再去 XAML 里找写死的字符串。 -->
    <Version>0.1.1</Version>
    <Product>YEEYEEYEE</Product>
    <AssemblyTitle>YEEYEEYEE</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\YEEYEEYEE.Desktop.Core\YEEYEEYEE.Desktop.Core.csproj" />
    <!-- 共享的无界面代码（Agent 服务层、密钥落盘、出图/出视频链路、智能导入、站点池子…）。
         以前是这一端用 42 条 <Compile Include> 直接从旧 WinForms 端「借」源码；现在它们是
         一个正常的库，来源只有一处（见 YEEYEEYEE.Desktop.Shared.csproj 里的说明）。 -->
    <ProjectReference Include="..\YEEYEEYEE.Desktop.Shared\YEEYEEYEE.Desktop.Shared.csproj" />
    <ProjectReference Include="..\YEEYEEYEE.Host\YEEYEEYEE.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.9" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.9" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.9" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.9" />
    <!-- 覆盖传递依赖里那个带漏洞的 D-Bus 协议库：Avalonia.Desktop 会带进 Tmds.DBus.Protocol 0.21.2，
         而 GHSA-xrw6-gwf8-vvr9（CVE-2026-39959）影响 < 0.21.3——同一个总线上怀恶意的对端可以伪造信号、
         耗尽文件描述符、或发畸形报文把进程打崩。修好的版本是 0.21.3（0.92.0 那一支也修了）。
         这条洞只在 Linux 桌面上够得着（要有一条 D-Bus 总线），Windows / macOS 上到不了；
         但它就在依赖图里，所以照样升掉。 -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>

  <!-- 每个厂家一张「形象」（开奖许愿那一拍用，见 ProviderAvatar）。放在仓库根目录的 provider-art/ 下，
       构建时拷进输出目录，程序就从**程序目录旁的 provider-art/** 读到它们；用户配置目录里那一份优先，
       所以用户自己换的图不会被版本更新覆盖掉。
       CopyToOutputDirectory 用 PreserveNewest：重复构建不会每次重拷这几 MB。 -->
  <ItemGroup>
    <None Include="..\provider-art\**\*"
          Link="provider-art\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

  <!-- 共享界面文案（UiText）由 Desktop.Shared 那边嵌（EmbeddedResource → 网页端项目里的
       src/shared/uiText.json），这一端不再有一条：嵌在共享层是为了让服务端与 Agent 侧读到同一份，
       而这一端本来就引用共享层，UiText 直接可用（XAML 里走 shared: 前缀的 x:Static）。 -->
</Project>
