<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="YEEYEEYEE.Desktop.Avalonia.AgentPanel">

  <!-- Agent 协作面板：与节点检查器共用右侧栏，切换到 Agent 时显示。
       视觉沿用工作台的玻璃壳层（App.axaml 里的 glass / chip / toolButton 等样式）。 -->
  <Border Classes="glass">
    <Panel>
      <Border Classes="edgeTop" IsHitTestVisible="False" />
      <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- ===== 标题栏 ===== -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Height="50" Margin="16,1,10,0">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="✦" Foreground="{StaticResource DfPrimary}" FontSize="13" VerticalAlignment="Center" />
            <TextBlock Text="Agent 协作" Classes="heading" FontSize="13" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
            <Button x:Name="UndoLastButton" Classes="toolButton" Content="↺" IsVisible="False"
                    ToolTip.Tip="撤销上一批 Agent 改动" Click="UndoLast_OnClick" />
            <Button Classes="toolButton" Content="✚" ToolTip.Tip="新建对话（清空上下文）" Click="NewConversation_OnClick" />
            <Button x:Name="OnboardingButton" Classes="toolButton" Content="★"
                    ToolTip.Tip="接入引导：选服务商 / 填密钥 / 测试连接" Click="Onboarding_OnClick" />
            <Button Classes="toolButton" Content="⚙" ToolTip.Tip="模型接入设置（自定义接口格式与上下文）" Click="ModelSettings_OnClick" />
            <Button Classes="toolButton" Content="›" ToolTip.Tip="收起，回到节点检查器" Click="Close_OnClick" />
          </StackPanel>
        </Grid>

        <!-- ===== 授权模式 / 上下文开关 ===== -->
        <!-- 模型选择已经搬到输入框下面：它是「发这条消息要用谁」，跟输入框是一组，
             放在这儿会跟授权模式混成一堆看不出主次的开关。 -->
        <StackPanel x:Name="AuthPanel" Grid.Row="1" Margin="16,0,16,12" Spacing="7">
          <TextBlock Text="授权模式" Classes="dim" FontSize="11" VerticalAlignment="Center" />
          <ComboBox x:Name="AuthModeBox" HorizontalAlignment="Stretch" FontSize="12"
                    SelectionChanged="AuthMode_OnSelectionChanged">
            <ComboBoxItem Content="逐条审批：先把改动算出来，确认后才写画布" />
            <ComboBoxItem Content="自动应用：直接改画布并保存" />
            <ComboBoxItem Content="只读不提议：只讨论，不接受任何改动" />
          </ComboBox>
          <CheckBox x:Name="UseContextBox" Content="带上画布上下文" IsChecked="True" FontSize="11"
                    Foreground="{StaticResource DfInk2}"
                    Checked="UseContext_OnChanged" Unchecked="UseContext_OnChanged" />
        </StackPanel>

        <!-- ===== 对话区 ===== -->
        <ScrollViewer Grid.Row="2" x:Name="ConversationScroll" Padding="16,0,16,0"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="MessageList" Spacing="10" />
        </ScrollViewer>

        <!-- ===== 输入区 ===== -->
        <StackPanel x:Name="InputPanel" Grid.Row="3" Margin="16,12,16,14" Spacing="9">

          <!-- 待审批改动：保存或放弃 -->
          <Border x:Name="ApprovalCard" IsVisible="False" Background="{StaticResource DfPrimarySoft}"
                  BorderBrush="{StaticResource DfLineGlow}" BorderThickness="1" CornerRadius="10" Padding="11">
            <StackPanel Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="✦" Foreground="{StaticResource DfPrimary}" FontSize="12" />
                <TextBlock x:Name="ApprovalTitle" Text="待审批改动" Foreground="{StaticResource DfInk}"
                           FontSize="12" FontWeight="SemiBold" />
              </StackPanel>
              <TextBlock x:Name="ApprovalDiff" Classes="muted" FontSize="11" TextWrapping="Wrap" LineHeight="17" />
              <StackPanel x:Name="ApprovalLines" Spacing="2" />
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Button x:Name="ApproveButton" Classes="primary" Content="保存并写入画布" Click="Approve_OnClick" />
                <Button Classes="miniButton" Content="放弃这批改动" Click="Discard_OnClick" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- 待发送附件 -->
          <WrapPanel x:Name="AttachmentChips" Orientation="Horizontal" IsVisible="False" />

          <!-- 输入框 -->
          <Border Background="{StaticResource DfSurface2}" BorderBrush="{StaticResource DfLine}"
                  BorderThickness="1" CornerRadius="10" Padding="10,8">
            <Grid RowDefinitions="Auto,Auto">
              <TextBox x:Name="InputBox" Classes="inlineInput"
                       Watermark="描述你要做什么，例如「按剧情自动建立第一章节点」"
                       AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120" FontSize="12" />
              <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,6,0,0">
                <Button Classes="miniButton" Content="＋ 附件" ToolTip.Tip="把图片或文本文件带进对话"
                        Click="Attach_OnClick" />
                <Button Grid.Column="1" x:Name="ClearAttachButton" Classes="miniButton" Content="清空附件"
                        IsVisible="False" Margin="6,0,0,0" Click="ClearAttach_OnClick" />
                <TextBlock Grid.Column="2" x:Name="PanelStatusText" Classes="dim" FontSize="10"
                           VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis" />
                <!-- 发送与停止是同一个按钮：空闲时「发送」，正在跑时「停止」。
                     两个按钮换来换去会让人先找按钮在哪，再想该点哪个。 -->
                <Button Grid.Column="3" x:Name="SendButton" Classes="primary" Content="发送" Click="Send_OnClick" />
              </Grid>
            </Grid>
          </Border>

          <!-- 使用模型：放在输入框下面，紧挨着「这条消息要用谁」这件事。
               切换只影响之后的消息，正在跑的这一轮不会被换掉——半路换模型会让同一条回复前后由两个模型写成。 -->
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
            <TextBlock Text="使用模型" Classes="dim" FontSize="10" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" x:Name="ModelBox" Classes="panelCombo" HorizontalAlignment="Stretch"
                      SelectionChanged="Model_OnSelectionChanged" />
            <Button Grid.Column="2" Classes="miniButton" Content="管理…" FontSize="10"
                    ToolTip.Tip="打开设置：模型接入 / 生图生视频 / 技能管理" Click="ModelSettings_OnClick" />
          </Grid>

          <!-- 上一轮的用量。取不到的服务端一律显示 ——，不拿 0 冒充（0 会被读成"没花 token"）。 -->
          <TextBlock x:Name="UsageText" Classes="dim" FontSize="10" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>
    </Panel>
  </Border>
</UserControl>
