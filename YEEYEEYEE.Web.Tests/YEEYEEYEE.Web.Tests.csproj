<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- 跟被测的 Web 项目保持一致：它为了能跑在 Linux 容器里已经从 net10.0-windows 改成 net10.0，
         测试项目留在 windows 上会引用不上。 -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\YEEYEEYEE.Web\YEEYEEYEE.Web.csproj" />
  </ItemGroup>
</Project>
