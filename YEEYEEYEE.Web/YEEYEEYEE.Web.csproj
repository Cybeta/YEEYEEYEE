<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\YEEYEEYEE.Host\YEEYEEYEE.Host.csproj" />
    <ProjectReference Include="..\YEEYEEYEE.Desktop.Core\YEEYEEYEE.Desktop.Core.csproj" />
    <!--
      泳道布局引擎（CanvasSwimlaneLayout 那一批）住在 Desktop.Shared 里。
      它同样是 net10.0、而且刻意不含任何 UI 框架依赖，所以 Web 服务可以直接引用**同一份**，
      不必在 TypeScript 里再写一份——两份实现在同一张画布上排出来的结果迟早会不一样。
      注意 Shared 里带着 SecretCiphers / SecretProtector（DPAPI）：那部分在 Linux 上编译得过、
      调用会抛，所以这条链上**不要碰到它**（容器部署跑的就是这个进程）。
    -->
    <ProjectReference Include="..\YEEYEEYEE.Desktop.Shared\YEEYEEYEE.Desktop.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.9" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      这里**故意不是 net10.0-windows**：Web 服务要能跑在 Linux 容器里（一键部署那条路）。
      它引用的 Host 与 Desktop.Core 本来就是 net10.0，两边一致之后，
      整个 Web 进程链上没有任何 Windows-only 的 API（DPAPI 那类只在桌面端的 SecretProtector 里）。
      改回去之前请先确认 Docker 那条路还走得通。
    -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
