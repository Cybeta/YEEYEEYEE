<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\YEEYEEYEE.Core\YEEYEEYEE.Core.csproj" />
    <ProjectReference Include="..\YEEYEEYEE.Host\YEEYEEYEE.Host.csproj" />
    <ProjectReference Include="..\YEEYEEYEE.Desktop.Core\YEEYEEYEE.Desktop.Core.csproj" />
    <!-- Agent 操作层（AgentAction / AgentActionExecutor）在共享库里：
         第 127 轮之前它住在旧 WinForms 端项目里，本工程当时就是引用那个项目拿到的；
         那一轮有个改动把引用换成了 Desktop.Core，`AgentActionExecutor` 就找不到了（工作区一直是编译不过的状态）。 -->
    <ProjectReference Include="..\YEEYEEYEE.Desktop.Shared\YEEYEEYEE.Desktop.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.9" />
  </ItemGroup>

  <!-- 协议表与它的固定样本：**还是同一份文件**（住在 YEEYEEYEE.Canvas/src/shared/）。
       测试直接读源码树里的那两份，用来核「C# 嵌的就是它」以及「样本逐条都对得上」——
       拷成副本的话，副本过期这件事本身又没人管了。 -->
  <ItemGroup>
    <Content Include="..\YEEYEEYEE.Canvas\src\shared\protocol.json" Link="fixtures\protocol.json" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <Content Include="..\YEEYEEYEE.Canvas\src\shared\protocolFixtures.json" Link="fixtures\protocolFixtures.json" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
